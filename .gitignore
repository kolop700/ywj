# Mac
.DS_Store
**/.DS_Store

# vim/vi
*.swp

# JavaScript
node_modules/
.node_modules/
.eslintcache
unpackage/dist/build/
unpackage/dist/dev/
unpackage/

# npm 本地缓存（构建包装脚本使用）
.npm-cache/

# 工作区内便携式 Android 工具链（JDK/SDK/Gradle 缓存，体积大且为本机专属）
.toolchain/

# Android 本地 SDK 路径（各机器不同）
shell-android/local.properties

# Android 签名证书（2026-10 起证书本体也不入库，仅留本机；密码文件一直不入库）
shell-android/keystore.properties
shell-android/keystore/

# python
*.pyc

# iOS 签名凭据（p12 私钥 / 描述文件，禁止入库，仅保留在本机 证书/ 目录）
*.p12
*.mobileprovision

# iOS 构建产物与依赖（xcodegen / pod install 生成，本地与 CI 每次自动重建，不入库；
# 注：shell-ios/Podfile.lock 建议入库以锁定依赖版本）
shell-ios/build/
shell-ios/Pods/
shell-ios/CloudGuard.xcodeproj/
shell-ios/CloudGuard.xcworkspace/

# 本地临时调试脚本（下划线前缀惯例：一次性工具脚本，不入库；已入库文件不再受影响）
scripts/_*

# 生产库数据备份（含真实订单/用户数据，禁止入库）
scripts/*.sql

# 调试截图与临时目录、杂项压缩包（不入库）
/_*.png
/_tmp_xy/
/qf-image-cropper.zip

# 测试用 pinia store（仅被 modules 自动 glob 收集，无业务引用）
store/modules/test.js
