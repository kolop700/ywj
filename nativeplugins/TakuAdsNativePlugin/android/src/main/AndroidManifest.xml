<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.yefiot.taku">

    <!-- ============================================================
         Litemize SDK 文档要求的权限（来源《SDK 集成》文档 v3.4.1）
         ============================================================ -->
    <!-- 必要权限：网络访问 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 可选权限 -->
    <!-- 访问网络状态：检测当前网络状态 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 显性下载进度（Android 13+ 通知栏显示下载进度和取消） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 设备信息：MAC 获取权限 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 应用安装权限（广告点击下载安装链路） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 粗略定位权限 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 传感器权限（震动） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 隐私合规提示（Litemize 文档建议可移除渠道引入的 QUERY_ALL_PACKAGES /
         READ_PHONE_STATE）。本项目主工程 manifest.json 已显式声明 READ_PHONE_STATE，
         为不影响既有功能，此处不做强制移除；如需合规收紧，可在 manifest.json 中自行删除。 -->

    <application
        android:networkSecurityConfig="@xml/network_security_config">
        <!--
          Taku 官方集成步骤 5.1(1)：Android 9+ Apache 兼容（来自官方
          release_folder 的 AndroidManifest.xml，原样保留）。缺失可能导致
          广告图片不显示或加载无回调。
        -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
    </application>

</manifest>
