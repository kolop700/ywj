				},
				{
					"path": "pages/agreement/privacy",
					"style": {
						"navigationBarTitleText": "隐私政策"
					}
				}
			]
		},
		{
			"root": "workbench_package",
			"pages": [
				{
					"path": "pages/visitor-password/index",
					"style": {
						"navigationBarTitleText": "临时访客密码"
					}
				},
				{
					"path": "pages/qrcode/index",
					"style": {
						"navigationBarTitleText": "二维码界面",
						"statusBarBackgroundColor": "#FCDEDE"
					}
				},
				{
					"path": "pages/my/index",
