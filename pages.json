	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "云小卫",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8",
		"app-plus": {
            "bounce": "none" 
        }
	},
	"uniIdRouter": {
		"loginPage": "user_package/pages/login/index",
		"needLogin": [
			"workbench_package/pages/.*"
		]
	}
