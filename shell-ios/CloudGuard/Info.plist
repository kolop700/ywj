<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>云卫家</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- App 图标：指向 Assets.xcassets 中 AppIcon（1024 无 alpha）-->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ==================== 场景（SceneDelegate） ==================== -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<key>UILaunchScreen</key>
	<dict/>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>bluetooth-le</string>
	</array>

	<!-- ==================== 权限用途说明 ==================== -->
	<key>NSCameraUsageDescription</key>
	<string>用于扫码开门及拍摄/上传图片</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>用于蓝牙连接门禁设备，实现开门功能</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>用于蓝牙连接门禁设备，实现开门功能</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选择图片</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于将图片保存到相册</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于蓝牙扫描及附近门禁设备发现</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于视频/语音相关功能</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>用于向您提供更相关的广告内容</string>

	<!-- ==================== 广告归因 / 平台跳转 ==================== -->
	<!-- SKAdNetwork 归因 ID：首发仅列优量汇/穿山甲，接入更多广告平台后按 Taku 集成文档补充 -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>f7s53z58qe.skadnetwork</string>
		</dict>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>238da6jt44.skadnetwork</string>
		</dict>
	</array>
	<!-- 外询白名单：微信/支付宝（分享、广告平台检测与唤起） -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>weixin</string>
		<string>weixinULAPI</string>
		<string>alipay</string>
		<string>alipays</string>
	</array>

	<!-- ==================== 微信回跳（拉起小程序后返回本 App） ==================== -->
	<!-- 使用前：scheme 为「wx + 微信开放平台移动应用 AppId」（与 vip_pay_config.php 的 wechat.app_id 同一值） -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>weixin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wx4c80533df6184dda</string>
			</array>
		</dict>
	</array>

	<!-- ==================== 网络 ==================== -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
